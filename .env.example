# --- LLM (any OpenAI-compatible endpoint) ---
# Local options:
#   Ollama:    LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LM Studio: LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_VISION=gpt-4o
LLM_MODEL_CODE=gpt-4o
LLM_JSON_MODE=json_object            # json_object | json_schema | none
LLM_TEMPERATURE_CODE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_S=180                  # non-streaming request timeout
LLM_STREAM=true                    # SSE streaming (recommended for slow models)
LLM_IDLE_TIMEOUT_S=180             # max gap between stream chunks
LLM_TOTAL_TIMEOUT_S=1800           # hard cap per LLM call
# LLM_EXTRA_BODY={}; provider-specific extra payload fields, e.g.
#   {"chat_template_kwargs": {"enable_thinking": false}}  (Qwen3 on vLLM)
# Deterministic fake LLM for testing (path to a JSON script file or inline JSON).
# When set, no real provider is called. Example: LLM_FAKE_SCRIPT=/data/fake_llm.json
LLM_FAKE_SCRIPT=

# --- Agent defaults (overridable per project) ---
AGENT_MAX_ITERATIONS=3
AGENT_MAX_REPAIRS=3
AGENT_PASS_SCORE=80
AGENT_DIM_TOLERANCE_PCT=2
AGENT_DIM_TOLERANCE_MM=0.5
AGENT_CLARIFICATION_MODE=assume      # assume | ask
AGENT_MAX_INPUT_IMAGES=8
AGENT_MAX_TOKENS_PER_JOB=400000
AGENT_MAX_WALL_S=900

# --- Generation mode ---
AGENT_DEFAULT_GEN_MODE=auto              # auto | cad | mesh | hybrid

# --- Mesh generator sidecar (mesh_server/ — see docs/mesh-generation.md) ---
# Runs NATIVELY on the host (Docker on macOS has no GPU). Start: make mesh-server
# NOTE: inside docker 'localhost' is the container itself — compose defaults to
# http://host.docker.internal:8765; for native dev use http://localhost:8765
MESH_BASE_URL=                           # empty = mesh/hybrid disabled
MESH_MODEL=auto                          # auto | trellis2 | hunyuan3d-2.1-mlx | hunyuan3d-2mini | hunyuan3d-2mv | triposg | fake
MESH_TIMEOUT_S=900
MESH_FAKE=                               # 1 = deterministic fake mesh (tests/E2E without GPU)
MESH_DECIMATE_FACES=30000
MESH_MAX_FACES_FOR_CAD=60000

# --- Executor ---
EXEC_TIMEOUT_S=180
EXEC_MEM_LIMIT_MB=4096

# --- Infra ---
DATA_DIR=./data
DATABASE_URL=postgresql://cadagent:cadagent@localhost:5432/cadagent
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=cadagent
POSTGRES_PASSWORD=cadagent
POSTGRES_DB=cadagent
