# KIARA — docker-compose overrides only.
# Copy to .env if you want to change defaults. The app itself does NOT read
# this file — all runtime configuration lives in the database and is edited
# via the Settings page (see docs/configuration.md).

# Postgres credentials / database name (used to build DATABASE_URL).
# Change POSTGRES_PASSWORD for any shared or network-exposed deployment —
# the default is for local single-user use.
POSTGRES_USER=kiara
POSTGRES_PASSWORD=kiara
POSTGRES_DB=kiara

# Where the api/worker containers reach the native mesh-server sidecar.
# Default reaches a mesh-server running on the docker host.
MESH_BASE_URL=http://host.docker.internal:8765

# Guide blender-mode bridge (guide_mode=blender|auto): the worker talks
# JSON/TCP to the BlenderMCP addon inside a running Blender instance.
# Blender only writes host paths, so KIARA_DATA_HOST_ROOT must be the
# HOST-side absolute path of this repo's ./data dir (mounted into the
# worker as /data) — exports/screenshots/renders travel through it.
#KIARA_BLENDER_HOST=host.docker.internal
#KIARA_BLENDER_PORT=9876
#KIARA_DATA_HOST_ROOT=/absolute/host/path/to/3d_model_agent/data

# Set to 1 for a deterministic fake mesh adapter (no GPU needed, for tests)
MESH_FAKE=

# ROCm only: override the detected GPU GFX version for the mesh-server
# container (e.g. 10.3.0 for gfx1030). See docs/mesh-generation.md.
#HSA_OVERRIDE_GFX_VERSION=
