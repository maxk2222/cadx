# CADX — docker-compose overrides only.
# Copy to .env if you want to change defaults. The app itself does NOT read
# this file — all runtime configuration lives in the database and is edited
# via the Settings page (see docs/configuration.md).

# Postgres credentials / database name (used to build DATABASE_URL)
POSTGRES_USER=cadx
POSTGRES_PASSWORD=cadx
POSTGRES_DB=cadx

# Where the api/worker containers reach the native mesh-server sidecar
MESH_BASE_URL=http://host.docker.internal:8765

# Set to 1 for a deterministic fake mesh adapter (no GPU needed, for tests)
MESH_FAKE=
