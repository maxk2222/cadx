{
  "name": "l_bracket_rib",
  "project": "eval:l-bracket-rib",
  "difficulty": 1,
  "description": "Aluminium L-bracket with triangular reinforcement rib — dimensional + feature gates plus a standalone FEM check.",
  "settings": { "gen_mode": "cad" },
  "stages": [
    {
      "id": "codegen",
      "type": "generate",
      "mode": "cad",
      "timeout_s": 5400,
      "options": { "process": "fdm" },
      "prompt": "Aluminium L-bracket (6061), parametric.\n\nFrame: bottom face on the XY plane (z = 0), centred in X and Y. mm.\n- Base plate 80 x 60 x 6.\n- Upright plate at the -X edge on the base top face: 60 wide, 6 thick, 60 tall (top at z = 66).\n- 4 holes dia 8.5: two through the base along Z at (x=25, y=+20) and (x=25, y=-20); two through the upright along X at (y=+20, z=36) and (y=-20, z=36).\n- Triangular rib 4 mm thick in the inner corner, centred in Y, ~40 mm legs.\n- Fillets: r3 in the corner and at the rib, r2 on other edges.\nSymmetric in Y.",
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "bbox", "dims": [80, 60, 66], "match": "match", "tol_mm": 3 },
        { "type": "holes", "count": 2, "dia": 8.5, "axis": "z", "positions": [[25, 20], [25, -20]] },
        { "type": "holes", "count": 2, "dia": 8.5, "axis": "x" },
        { "type": "fillet" },
        { "type": "dfm", "process": "fdm", "max_high": 0 },
        { "type": "contains_point", "xyz": [-15, 0, 10] },
        { "type": "watertight", "expect": true },
        { "type": "verify_spec", "expect": "PASS" }
      ]
    },
    {
      "id": "fem",
      "type": "fem",
      "timeout_s": 1800,
      "material": "aluminum",
      "load_cases": [
        {
          "name": "tip_load",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [25, 20, 3], "diameter_mm": 10, "margin_mm": 3 },
            { "kind": "cylinder", "axis": "z", "center": [25, -20, 3], "diameter_mm": 10, "margin_mm": 3 }
          ],
          "loads": [
            {
              "region": { "kind": "face", "axis": "+z", "margin_mm": 2 },
              "force_n": [0, 0, -500]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded"] },
        { "type": "fem", "field": "sf", "min": 1.0 }
      ]
    },
    {
      "id": "params",
      "type": "params",
      "enabled": false,
      "params": { "plate_thickness": 8 },
      "gates": [
        { "type": "status", "expect": ["succeeded"] }
      ]
    }
  ]
}
