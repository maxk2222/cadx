{
  "name": "robot_arm_mount",
  "project": "eval:robot-arm-mount",
  "difficulty": 3,
  "description": "Topology-optimized robot-arm mount — base part codegen, baseline FEM, then SIMP optimization with keep-region/SF/volfrac gates.",
  "settings": { "gen_mode": "cad" },
  "stages": [
    {
      "id": "codegen",
      "type": "generate",
      "mode": "cad",
      "timeout_s": 5400,
      "prompt": "Mounting bracket for a robot-arm joint (aluminium 6061), parametric — it will be topology-optimized afterwards.\n\nFrame: base plate on the XY plane, centred at origin; mm units.\n- Base plate 100 (X) x 80 (Y) x 10 (Z) mm.\n- Four M8 clearance holes dia 8.5 mm at (x=+/-42, y=+/-32), through Z.\n- Raised bearing boss on the plate top face: cylinder dia 25 mm, 15 mm tall, centred at origin, with a dia 12 mm through-bore along Z.\n- Opposing connection face: a 30 (X) x 40 (Y) x 8 (Z) flange plate standing at the +X edge of the base plate, with two dia 6.5 mm holes along X.\n- Branching reinforcement ribs on the plate top connecting the boss, the mounting-hole pads and the connection face — organic merged ribs, wall thickness >= 3 mm.\nSymmetric in Y. Mechanically loadable: the four corner holes take the mounting bolts, the bearing bore takes the radial joint load.\nDeclare load case: all four corner holes fixed; 600 N bearing load in -Z on the bore wall.",
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "bbox", "dims": [100, 80, 40], "match": "within", "tol_mm": 4 },
        { "type": "holes", "count": 4, "dia": 8.5, "axis": "z", "positions": [[42, 32], [42, -32], [-42, 32], [-42, -32]] },
        { "type": "holes", "count": 1, "dia": 12, "axis": "z" },
        { "type": "watertight", "expect": true },
        { "type": "verify_spec", "expect": "PASS" }
      ]
    },
    {
      "id": "fem",
      "type": "fem",
      "timeout_s": 1800,
      "material": "aluminum",
      "load_cases": [
        {
          "name": "joint_radial",
          "fixed": [
            { "kind": "hole", "hole_index": 1 },
            { "kind": "hole", "hole_index": 2 },
            { "kind": "hole", "hole_index": 3 },
            { "kind": "hole", "hole_index": 4 }
          ],
          "loads": [
            {
              "region": { "kind": "bore", "center": [0, 0, 20], "diameter_mm": 12 },
              "bearing_n": 600,
              "bearing_dir": [0, 0, -1]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded"] },
        { "type": "fem", "field": "sf", "min": 0.5 }
      ]
    },
    {
      "id": "topopt",
      "type": "optimize",
      "timeout_s": 7200,
      "material": "aluminum",
      "optimize": {
        "enabled": true,
        "target_volume_fraction": 0.5,
        "safety_factor_min": 1.5,
        "min_member_mm": 3,
        "filter": "helmholtz+heaviside",
        "keep_mode": "auto",
        "max_iterations": 200
      },
      "load_cases": [
        {
          "name": "joint_radial",
          "fixed": [
            { "kind": "hole", "hole_index": 1 },
            { "kind": "hole", "hole_index": 2 },
            { "kind": "hole", "hole_index": 3 },
            { "kind": "hole", "hole_index": 4 }
          ],
          "loads": [
            {
              "region": { "kind": "bore", "center": [0, 0, 20], "diameter_mm": 12 },
              "bearing_n": 600,
              "bearing_dir": [0, 0, -1]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "topopt", "field": "sf_export", "min": 1.5 },
        { "type": "volfrac", "min": 0.35, "max": 0.65 },
        { "type": "bodies", "max": 1 },
        { "type": "envelope_within", "dims": [100, 80, 40], "tol_mm": 4 },
        { "type": "holes", "count": 4, "dia": 8.5, "axis": "z" },
        { "type": "watertight", "expect": true }
      ]
    },
    {
      "id": "refine",
      "type": "refine",
      "enabled": false,
      "timeout_s": 3600,
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] }
      ]
    }
  ]
}
