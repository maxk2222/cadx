{
  "name": "robot_arm_mount",
  "project": "eval:robot-arm-mount",
  "difficulty": 3,
  "description": "Topology-optimized robot-arm mount — base part codegen, baseline FEM, then SIMP optimization with keep-region/SF/volfrac gates.",
  "settings": { "gen_mode": "cad" },
  "stages": [
    {
      "id": "codegen",
      "type": "generate",
      "mode": "cad",
      "timeout_s": 7800,
      "prompt": "Mounting bracket for a robot-arm joint (aluminium 6061), parametric — input for topology optimization.\n\nFrame: base plate on the XY plane (z = 0), centred in X and Y. mm.\n- Base plate 100 x 80 x 10.\n- 4 holes dia 8.5 along Z at (x=+/-42, y=+/-32) — mounting bolts.\n- Bearing boss dia 25 x 15 tall on the plate centre (top at z = 25) with a dia 12 through-bore along Z — bearing seat.\n- Vertical flange at the +X edge on the plate: 8 thick, 40 wide (y-centred), 30 tall (z = 10..40); two dia 6.5 holes along X at (y=+/-12, z=25).\n- One gusset rib 5 mm thick at y = 0 joining boss and flange.\nSymmetric in Y.",
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "bbox", "dims": [100, 80, 40], "match": "within", "tol_mm": 4 },
        { "type": "holes", "count": 4, "dia": 8.5, "axis": "z", "positions": [[42, 32], [42, -32], [-42, 32], [-42, -32]] },
        { "type": "holes", "count": 1, "dia": 12, "axis": "z" },
        { "type": "holes", "count": 2, "dia": 6.5, "axis": "x" },
        { "type": "watertight", "expect": true },
        { "type": "verify_spec", "expect": "PASS" }
      ]
    },
    {
      "id": "fem",
      "type": "fem",
      "timeout_s": 1800,
      "material": "aluminum",
      "load_cases": [
        {
          "name": "joint_radial",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2 }
          ],
          "loads": [
            {
              "region": { "kind": "cylinder", "axis": "z", "center": [0, 0, 15], "diameter_mm": 14, "margin_mm": 2 },
              "force_n": [0, 0, -600]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded"] },
        { "type": "fem", "field": "sf", "min": 0.5 }
      ]
    },
    {
      "id": "topopt",
      "type": "optimize",
      "timeout_s": 7200,
      "material": "aluminum",
      "optimize": {
        "enabled": true,
        "target_volume_fraction": 0.5,
        "safety_factor_min": 1.5,
        "min_member_mm": 3,
        "filter": "helmholtz+heaviside",
        "keep_mode": "auto",
        "max_iterations": 200
      },
      "load_cases": [
        {
          "name": "joint_radial",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2 },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2 }
          ],
          "loads": [
            {
              "region": { "kind": "cylinder", "axis": "z", "center": [0, 0, 15], "diameter_mm": 14, "margin_mm": 2 },
              "force_n": [0, 0, -600]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "topopt", "field": "sf_verified", "min": 1.5 },
        { "type": "volfrac", "min": 0.35, "max": 0.65 },
        { "type": "bodies", "max": 1 },
        { "type": "envelope_within", "dims": [100, 80, 40], "tol_mm": 4 },
        { "type": "holes", "count": 4, "dia": 8.5, "axis": "z" },
        { "type": "watertight", "expect": true }
      ]
    },
    {
      "id": "refine",
      "type": "refine",
      "enabled": false,
      "timeout_s": 3600,
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] }
      ]
    }
  ]
}
