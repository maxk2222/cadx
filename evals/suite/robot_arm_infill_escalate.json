{
  "name": "robot_arm_infill_escalate",
  "project": "eval:robot-arm-escalate",
  "difficulty": 3,
  "description": "Infill -> SIMP escalation: guided-infill baseline first, then a full OC run warm-started from the parent's stored density (warm_density_relpath=auto:parent). Gates verify the warm start actually engaged.",
  "settings": { "gen_mode": "cad" },
  "stages": [
    {
      "id": "codegen",
      "type": "generate",
      "mode": "cad",
      "timeout_s": 7800,
      "prompt": "Mounting bracket for a robot-arm joint (aluminium 6061), parametric — input for topology optimization.\n\nFrame: base plate on the XY plane (z = 0), centred in X and Y. mm.\n- Base plate 100 x 80 x 10.\n- 4 holes dia 8.5 along Z at (x=+/-42, y=+/-32) — mounting bolts.\n- Bearing boss dia 25 x 15 tall on the plate centre (top at z = 25) with an M12 tapped (internal thread, M12x1.75) through-bore along Z — model the bore at tap-drill size and declare the thread; the export rebuild carries the real thread groove — threaded shaft seat.\n- Vertical flange at the +X edge on the plate: 8 thick, 40 wide (y-centred), 30 tall (z = 10..40); two dia 6.5 holes along X at (y=+/-12, z=25).\n- One gusset rib 5 mm thick at y = 0 joining boss and flange.\nSymmetric in Y.",
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "bbox", "dims": [100, 80, 40], "match": "within", "tol_mm": 4 },
        { "type": "watertight", "expect": true },
        { "type": "verify_spec", "expect": "PASS" }
      ]
    },
    {
      "id": "infill",
      "type": "optimize",
      "timeout_s": 5400,
      "material": "aluminum",
      "optimize": {
        "enabled": true,
        "structure_mode": "infill",
        "infill_scope": "guided",
        "infill_guide_solver": "beso",
        "target_volume_fraction": 0.5,
        "safety_factor_min": 1.5,
        "min_member_mm": 3,
        "keep_mode": "auto"
      },
      "load_cases": [
        {
          "name": "axial",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "bore", "axis": "+z", "center": [0, 0, 15], "diameter_mm": 10.25, "description": "M12 seat wall (hint-bound)" },
              "force_n": [0, 0, -600]
            }
          ]
        },
        {
          "name": "overturn",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "cylinder", "axis": "z", "center": [0, 0, 15], "diameter_mm": 14, "z_range": [10, 25], "description": "boss section (shaft-seat couple)" },
              "moment_nm": [0, 100, 0]
            }
          ]
        },
        {
          "name": "link",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "hole", "axis": "+x", "center": [46, 12, 25], "diameter_mm": 6.5, "description": "flange pin +y (hint-bound)" },
              "force_n": [0, 0, -150]
            },
            {
              "region": { "kind": "hole", "axis": "+x", "center": [46, -12, 25], "diameter_mm": 6.5, "description": "flange pin -y (hint-bound)" },
              "force_n": [0, 0, -150]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "topopt", "field": "sf_verified", "min": 1.5 },
        { "type": "bodies", "max": 1 },
        { "type": "watertight", "expect": true }
      ]
    },
    {
      "id": "simp_warm",
      "type": "optimize",
      "timeout_s": 7200,
      "material": "aluminum",
      "options": { "allow_reopt": true },
      "optimize": {
        "enabled": true,
        "structure_mode": "simp",
        "solver": "oc",
        "warm_density_relpath": "auto:parent",
        "target_volume_fraction": 0.5,
        "safety_factor_min": 1.5,
        "min_member_mm": 3,
        "filter": "helmholtz+heaviside",
        "keep_mode": "auto",
        "max_iterations": 80
      },
      "load_cases": [
        {
          "name": "axial",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "bore", "axis": "+z", "center": [0, 0, 15], "diameter_mm": 10.25, "description": "M12 seat wall (hint-bound)" },
              "force_n": [0, 0, -600]
            }
          ]
        },
        {
          "name": "overturn",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "cylinder", "axis": "z", "center": [0, 0, 15], "diameter_mm": 14, "z_range": [10, 25], "description": "boss section (shaft-seat couple)" },
              "moment_nm": [0, 100, 0]
            }
          ]
        },
        {
          "name": "link",
          "fixed": [
            { "kind": "cylinder", "axis": "z", "center": [42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, 32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" },
            { "kind": "cylinder", "axis": "z", "center": [-42, -32, 5], "diameter_mm": 14, "margin_mm": 2, "z_range": [0, 10], "description": "bolt pad" }
          ],
          "loads": [
            {
              "region": { "kind": "hole", "axis": "+x", "center": [46, 12, 25], "diameter_mm": 6.5, "description": "flange pin +y (hint-bound)" },
              "force_n": [0, 0, -150]
            },
            {
              "region": { "kind": "hole", "axis": "+x", "center": [46, -12, 25], "diameter_mm": 6.5, "description": "flange pin -y (hint-bound)" },
              "force_n": [0, 0, -150]
            }
          ]
        }
      ],
      "gates": [
        { "type": "status", "expect": ["succeeded", "needs_review"] },
        { "type": "topopt", "field": "sf_verified", "min": 1.5 },
        { "type": "topopt", "field": "warm_start" },
        { "type": "volfrac", "min": 0.35, "max": 0.65 },
        { "type": "bodies", "max": 1 },
        { "type": "envelope_within", "dims": [100, 80, 40], "tol_mm": 4 },
        { "type": "load_path", "expect": true },
        { "type": "watertight", "expect": true }
      ]
    }
  ]
}
