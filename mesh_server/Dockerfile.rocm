# mesh-server on AMD (ROCm): TripoSG + diffusers image adapters.
#
# Build:  docker build -f mesh_server/Dockerfile.rocm -t meshserver:rocm .
# Run:    docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#           --group-add render --ipc=host -p 8765:8765 \
#           -v mesh_models:/models meshserver:rocm
#
# The rocm/pytorch base ships a HIP-enabled torch that reuses the cuda device
# namespace (torch.version.hip). Override the base tag via --build-arg if your
# ROCm host install is newer. Unsupported gfx archs may need
# HSA_OVERRIDE_GFX_VERSION at runtime.
# NOTE: rocm/pytorch ubuntu22.04 images ship py3.10 only (below our
# requires-python>=3.11) — the py3.12 builds live on ubuntu24.04
ARG ROCM_BASE=rocm/pytorch:rocm6.4.3_ubuntu24.04_py3.12_pytorch_release_2.6.0
FROM ${ROCM_BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MESH_MODEL_DIR=/models \
    MESH_DEVICE=rocm \
    MESH_PORT=8765 \
    HF_HOME=/models/hf \
    # reduces fragmentation-related OOMs on HIP
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs build-essential ninja-build curl ca-certificates \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY meshserver ./meshserver

# core deps — install into the base image's system python: its ROCm torch
# already satisfies 'torch>=2.4', so uv keeps the HIP build instead of pulling
# a CUDA wheel from PyPI (a fresh venv would NOT see the base image's torch!)
RUN uv pip install --system -e ".[rocm]" 'scikit-image>=0.24'

# Optional: local-LLM backends (llama.cpp GGUF serving). llama-cpp-python
# compiles from source and needs cmake — opt in with --build-arg WITH_LLM=1.
# The built-in catalog auto-shows GGUF variants on non-darwin hosts; for
# ROCm offload use a llama.cpp build with GGML_HIP.
ARG WITH_LLM=0
RUN if [ "$WITH_LLM" = "1" ]; then \
      apt-get update && apt-get install -y --no-install-recommends cmake && \
      rm -rf /var/lib/apt/lists/* && \
      uv pip install --system -e ".[llm]"; \
    fi

# Optional adapter sources — uncomment to bake TripoSG into the image, or run
# scripts/install_triposg.sh inside the container (it filters the CUDA-only
# `diso` extension and the numpy pin automatically on non-CUDA torch).
# RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSG.git /opt/triposg && \
#     uv pip install --system -e /opt/triposg

VOLUME /models
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD curl -sf http://localhost:8765/v1/health || exit 1

CMD ["meshserver", "serve", "--host", "0.0.0.0", "--port", "8765"]
