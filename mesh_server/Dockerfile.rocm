# mesh-server on AMD (ROCm): TripoSG + diffusers image adapters.
#
# Build:  docker build -f mesh_server/Dockerfile.rocm -t meshserver:rocm .
# Run:    docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#           --group-add render --ipc=host -p 8765:8765 \
#           -v mesh_models:/models meshserver:rocm
#
# The rocm/pytorch base ships a HIP-enabled torch that reuses the cuda device
# namespace (torch.version.hip). Override the base tag via --build-arg if your
# ROCm host install is newer. Unsupported gfx archs may need
# HSA_OVERRIDE_GFX_VERSION at runtime.
ARG ROCM_BASE=rocm/pytorch:rocm6.4.3_ubuntu22.04_py3.12_pytorch_release_2.6.0
FROM ${ROCM_BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MESH_MODEL_DIR=/models \
    MESH_DEVICE=rocm \
    MESH_PORT=8765 \
    HF_HOME=/models/hf \
    # reduces fragmentation-related OOMs on HIP
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs build-essential ninja-build curl ca-certificates \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY meshserver ./meshserver

# core deps — the base image's ROCm torch already satisfies 'torch>=2.4', so
# uv keeps the HIP build instead of pulling a CUDA wheel from PyPI
RUN uv venv /opt/venv --python python3 && \
    . /opt/venv/bin/activate && \
    uv pip install -e ".[rocm]"

ENV PATH=/opt/venv/bin:$PATH

# Optional adapter sources — uncomment to bake TripoSG into the image, or run
# scripts/install_triposg.sh inside the container.
# ARG TRIPOSG_COMMIT=main
# RUN git clone --depth 1 https://github.com/VAST-AI-Research/TripoSG.git /opt/triposg && \
#     . /opt/venv/bin/activate && uv pip install -e /opt/triposg

VOLUME /models
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD curl -sf http://localhost:8765/v1/health || exit 1

CMD ["meshserver", "serve", "--host", "0.0.0.0", "--port", "8765"]
